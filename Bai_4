import java.util.Scanner;

public class Main {
    public static int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Nhập a và b: ");
        int a = sc.nextInt();
        int b = sc.nextInt();

        int ucln = gcd(a, b);
        a /= ucln;
        b /= ucln;

        if (b < 0) { 
            a = -a;
            b = -b;
        }

        System.out.println(a + "/" + b);
    }
}
